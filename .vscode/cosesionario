  </div>


  <!-- ===================================================
       JAVASCRIPT
  ==================================================== -->

  <script>

    /* =====================================================
       INVENTARIO
    ===================================================== */

    const cars = [

      {
        id: 1,
        brand: "BMW",
        name: "M4 Competition",
        year: 2024,
        km: "8.500 km",
        engine: "3.0 Turbo",
        type: "Deportivo",
        price: 89900,
        image:
          "https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=1000&q=80",
        description:
          "BMW M4 Competition con motor 3.0 turbo, transmisión automática y un diseño deportivo de alto rendimiento."
      },

      {
        id: 2,
        brand: "Mercedes-Benz",
        name: "AMG GLE 53",
        year: 2024,
        km: "12.200 km",
        engine: "3.0 Turbo",
        type: "SUV",
        price: 98500,
        image:
          "https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1000&q=80",
        description:
          "SUV premium con tecnología avanzada, interior de lujo y excelente equilibrio entre confort y rendimiento."
      },

      {
        id: 3,
        brand: "Audi",
        name: "RS5 Sportback",
        year: 2023,
        km: "19.500 km",
        engine: "2.9 V6",
        type: "Deportivo",
        price: 79900,
        image:
          "https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?auto=format&fit=crop&w=1000&q=80",
        description:
          "Audi RS5 Sportback con motor V6 biturbo, tracción integral y un espectacular diseño."
      },

      {
        id: 4,
        brand: "Porsche",
        name: "911 Carrera",
        year: 2022,
        km: "15.800 km",
        engine: "3.0 Boxer",
        type: "Deportivo",
        price: 109000,
        image:
          "https://images.unsplash.com/photo-1503736334956-4c8f8e92946d?auto=format&fit=crop&w=1000&q=80",
        description:
          "Porsche 911 Carrera, uno de los deportivos más icónicos, con prestaciones excepcionales."
      },

      {
        id: 5,
        brand: "Toyota",
        name: "Land Cruiser",
        year: 2024,
        km: "6.300 km",
        engine: "2.8 Diesel",
        type: "SUV",
        price: 67000,
        image:
          "https://images.unsplash.com/photo-1519641471654-76ce0107ad1b?auto=format&fit=crop&w=1000&q=80",
        description:
          "Toyota Land Cruiser preparada para combinar comodidad, tecnología y capacidad todoterreno."
      },

      {
        id: 6,
        brand: "Tesla",
        name: "Model S",
        year: 2024,
        km: "5.200 km",
        engine: "Eléctrico",
        type: "Eléctrico",
        price: 74000,
        image:
          "https://images.unsplash.com/photo-1560958089-b8a1929cea89?auto=format&fit=crop&w=1000&q=80",
        description:
          "Tesla Model S completamente eléctrico con gran autonomía y tecnología de última generación."
      }

    ];


    /* =====================================================
       ELEMENTOS
    ===================================================== */

    const carsGrid = document.getElementById("carsGrid");

    const searchInput =
      document.getElementById("searchInput");

    const brandFilter =
      document.getElementById("brandFilter");

    const typeFilter =
      document.getElementById("typeFilter");

    const priceFilter =
      document.getElementById("priceFilter");

    const clearFilters =
      document.getElementById("clearFilters");


    /* =====================================================
       FORMATEAR PRECIO
    ===================================================== */

    function formatPrice(price) {

      return new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0
      }).format(price);

    }


    /* =====================================================
       MOSTRAR VEHÍCULOS
    ===================================================== */

    function renderCars(list = cars) {

      carsGrid.innerHTML = "";

      if (list.length === 0) {

        carsGrid.innerHTML = `
          <div style="
            grid-column: 1/-1;
            padding:60px 20px;
            text-align:center;
            color:#777;
          ">
            <h3>No encontramos vehículos</h3>
            <p>Prueba modificando los filtros.</p>
          </div>
        `;

        return;
      }


      list.forEach(car => {

        const card = document.createElement("article");

        card.className = "car-card";

        card.innerHTML = `

          <div class="car-image">

            <img
              src="${car.image}"
              alt="${car.brand} ${car.name}"
              loading="lazy"
            >

            <span class="car-badge">
              Disponible
            </span>

          </div>

          <div class="car-info">

            <div class="car-brand">
              ${car.brand}
            </div>

            <h3 class="car-name">
              ${car.name}
            </h3>

            <div class="car-details">
              <span>${car.year}</span>
              <span>${car.km}</span>
              <span>${car.type}</span>
            </div>

            <div class="car-footer">

              <div class="car-price">
                ${formatPrice(car.price)}
              </div>

              <button
                class="view-car"
                data-id="${car.id}"
              >
                VER DETALLES
              </button>

            </div>

          </div>
        `;

        carsGrid.appendChild(card);

      });


      document
        .querySelectorAll(".view-car")
        .forEach(button => {

          button.addEventListener("click", () => {

            const id =
              Number(button.dataset.id);

            openCarModal(id);

          });

        });

    }


    /* =====================================================
       FILTRAR
    ===================================================== */

    function filterCars() {

      const search =
        searchInput.value
          .toLowerCase()
          .trim();

      const brand =
        brandFilter.value;

      const type =
        typeFilter.value;

      const maxPrice =
        priceFilter.value
          ? Number(priceFilter.value)
          : Infinity;


      const filtered =
        cars.filter(car => {

          const matchesSearch =
            `${car.brand} ${car.name}`
              .toLowerCase()
              .includes(search);

          const matchesBrand =
            !brand ||
            car.brand === brand;

          const matchesType =
            !type ||
            car.type === type;

          const matchesPrice =
            car.price <= maxPrice;

          return (
            matchesSearch &&
            matchesBrand &&
            matchesType &&
            matchesPrice
          );

        });


      renderCars(filtered);

    }


    searchInput.addEventListener(
      "input",
      filterCars
    );

    brandFilter.addEventListener(
      "change",
      filterCars
    );

    typeFilter.addEventListener(
      "change",
      filterCars
    );

    priceFilter.addEventListener(
      "change",
      filterCars
    );


    clearFilters.addEventListener(
      "click",
      () => {

        searchInput.value = "";
        brandFilter.value = "";
        typeFilter.value = "";
        priceFilter.value = "";

        renderCars();

      }
    );


    /* =====================================================
       MODAL
    ===================================================== */

    const carModal =
      document.getElementById("carModal");

    const modalClose =
      document.getElementById("modalClose");


    function openCarModal(id) {

      const car =
        cars.find(item => item.id === id);

      if (!car) return;


      document.getElementById("modalImage").src =
        car.image;

      document.getElementById("modalImage").alt =
        `${car.brand} ${car.name}`;

      document.getElementById("modalBrand").textContent =
        car.brand;

      document.getElementById("modalName").textContent =
        car.name;

      document.getElementById("modalPrice").textContent =
        formatPrice(car.price);

      document.getElementById("modalYear").textContent =
        car.year;

      document.getElementById("modalKm").textContent =
        car.km;

      document.getElementById("modalEngine").textContent =
        car.engine;

      document.getElementById("modalType").textContent =
        car.type;

      document.getElementById("modalDescription").textContent =
        car.description;


      carModal.classList.add("active");

      document.body.style.overflow = "hidden";

    }


    function closeModal() {

      carModal.classList.remove("active");

      document.body.style.overflow = "";

    }


    modalClose.addEventListener(
      "click",
      closeModal
    );


    carModal.addEventListener(
      "click",
      event => {

        if (event.target === carModal) {
          closeModal();
        }

      }
    );


    document.addEventListener(
      "keydown",
      event => {

        if (event.key === "Escape") {
          closeModal();
        }

      }
    );


    /* =====================================================
       CALCULADORA DE FINANCIACIÓN
    ===================================================== */

    const vehiclePrice =
      document.getElementById("vehiclePrice");

    const downPayment =
      document.getElementById("downPayment");

    const loanMonths =
      document.getElementById("loanMonths");

    const interestRate =
      document.getElementById("interestRate");

    const monthlyPayment =
      document.getElementById("monthlyPayment");


    function calculateFinance() {

      const price =
        Number(vehiclePrice.value) || 0;

      const down =
        Number(downPayment.value) || 0;

      const months =
        Number(loanMonths.value) || 1;

      const annualRate =
        Number(interestRate.value) || 0;


      const principal =
        Math.max(price - down, 0);

      const monthlyRate =
        annualRate / 100 / 12;


      let payment;


      if (monthlyRate === 0) {

        payment =
          principal / months;

      } else {

        payment =
          principal *
          (
            monthlyRate *
            Math.pow(
              1 + monthlyRate,
              months
            )
          ) /
          (
            Math.pow(
              1 + monthlyRate,
              months
            ) - 1
          );

      }


      monthlyPayment.textContent =
        formatPrice(payment);

    }


    [
      vehiclePrice,
      downPayment,
      loanMonths,
      interestRate
    ].forEach(input => {

      input.addEventListener(
        "input",
        calculateFinance
      );

    });


    /* =====================================================
       CONTACTO
    ===================================================== */

    const contactForm =
      document.getElementById("contactForm");

    const toast =
      document.getElementById("toast");


    contactForm.addEventListener(
      "submit",
      event => {

        event.preventDefault();


        const name =
          document.getElementById("name").value;


        toast.textContent =
          `Gracias ${name}. Hemos recibido tu solicitud.`;

        toast.classList.add("show");


        contactForm.reset();


        setTimeout(() => {

          toast.classList.remove("show");

        }, 4000);

      }
    );


    /* =====================================================
       MENÚ MOBILE
    ===================================================== */

    const menuButton =
      document.getElementById("menuButton");

    const navLinks =
      document.getElementById("navLinks");


    menuButton.addEventListener(
      "click",
      () => {

        navLinks.classList.toggle("active");

      }
    );


    document
      .querySelectorAll(".nav-links a")
      .forEach(link => {

        link.addEventListener(
          "click",
          () => {

            navLinks.classList.remove("active");

          }
        );

      });


    /* =====================================================
       INICIO
    ===================================================== */

    renderCars();

    calculateFinance();

  </script>

</body>
</html>